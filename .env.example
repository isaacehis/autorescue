# Copy to .env.local. Keep .env.local out of Git.
# Set these again in Vercel Project Settings > Environment Variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_PHONE_E164=+234XXXXXXXXXX
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY="+234 XXX XXX XXXX"
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_OFFICE_CITY=Lagos
NEXT_PUBLIC_OFFICE_COUNTRY=Nigeria

# Server connection. Use the publishable key, never a service-role/admin key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Shared rate limiter, required for POST requests on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional exact origin, such as https://your-project.vercel.app.
# Leave unset to use the request origin for local development.
APP_ORIGIN=

# The supplied number is a property ID, not a GA4 measurement ID.
GOOGLE_ANALYTICS_PROPERTY_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
